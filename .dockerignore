# Source-control and local metadata
.git
.gitignore
.gitattributes
**/.DS_Store
**/.idea/
**/.vscode/
**/*.swp

# Local environment, agent, and SSH metadata
**/.env
**/.env.*
!**/.env.example
**/.claude/
**/.hermes/
**/.ssh/

# Conventional private-key basenames
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519

# Private-key and certificate-container extensions
**/*.pem
**/*.key
**/*.ppk
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Dependencies, generated output, and caches
**/node_modules/
**/dist/
**/coverage/
**/.cache/
**/.vite/
**/*.tsbuildinfo

# Runtime logs and audit sinks
**/[lL][oO][gG][sS]/
**/*.[lL][oO][gG]
**/*.[lL][oO][gG].*
**/*.[lL][oO][gG]-*
**/*.[jJ][sS][oO][nN][lL]
**/*.[jJ][sS][oO][nN][lL].*
**/*.[jJ][sS][oO][nN][lL]-*
**/*.[nN][dD][jJ][sS][oO][nN]
**/*.[nN][dD][jJ][sS][oO][nN].*
**/*.[nN][dD][jJ][sS][oO][nN]-*

# Temporary local artifacts
_data/
TEMP.md
TMP.md
temp/
model_cache/

# Compose and Docker development files are not runtime inputs
Dockerfile
.dockerignore
.docker/
*compose*.yaml
*compose*.yml
*Dockerfile*
*docker-compose*
