#!/usr/bin/env bash

# OMXTerm Web rollout. Non-destructive and app-scoped by design (issue #75):
#
# - never stages or resets operator work: a dirty checkout stops the deploy
#   before any Docker action, so tracked and untracked files are left as-is;
# - syncs source with fetch + fast-forward-only after verifying the branch and
#   its upstream, and refuses to run on a diverged branch (no merge, no rewrite);
# - recreates ONLY the OMXTerm Web service, leaving the reverse proxy and its
#   unrelated routes running.
#
# Paths are overridable via env so this can be exercised in a sandbox.

set -euo pipefail

# Resolve the checkout from OMXTerm-namespaced env only. Do NOT read the generic
# PROJECTS_DIR/CODE_DIR: unrelated tooling may already export them (e.g.
# PROJECTS_DIR=/some/base), and the old chain turned that into a wrong path
# like /some/base/code/omxterm-web, aborting the deploy before Docker (issue #85).
# OMXTERM_CODE_DIR is the code root; OMXTERM_DIR the full checkout the sandbox
# suite points at throwaway repos.
OMXTERM_CODE_DIR="${OMXTERM_CODE_DIR:-/opt}"
OMXTERM_DIR="${OMXTERM_DIR:-${OMXTERM_CODE_DIR}/omxterm-web}"
DEPLOY_BRANCH="${OMXTERM_DEPLOY_BRANCH:-main}"
OMXTERM_SERVICE="${OMXTERM_SERVICE:-omxterm-web}"
OMXTERM_DEPLOY_WAIT_TIMEOUT="${OMXTERM_DEPLOY_WAIT_TIMEOUT:-120}"

case "${OMXTERM_DEPLOY_WAIT_TIMEOUT}" in
  ''|*[!0-9]*|0)
    echo "deploy: OMXTERM_DEPLOY_WAIT_TIMEOUT must be a positive number of seconds." >&2
    exit 1
    ;;
esac

# The maintainer rollout layers the production edge topology (compose.prod.yml)
# on top of the portable, safe-by-default baseline (compose.yml), so a
# separate-stack reverse proxy keeps its route to the broker after an update.
# Both are overridable; clear OMXTERM_COMPOSE_OVERRIDE to deploy the plain
# baseline instead.
OMXTERM_COMPOSE_FILE="${OMXTERM_COMPOSE_FILE:-compose.yml}"
# No colon: an explicitly empty OMXTERM_COMPOSE_OVERRIDE means "no override"
# (deploy the plain baseline), while leaving it unset applies the default.
OMXTERM_COMPOSE_OVERRIDE="${OMXTERM_COMPOSE_OVERRIDE-compose.prod.yml}"

cd "${OMXTERM_DIR}"

# Reject an exposed production secret before consulting Git or invoking Docker.
# GNU stat (Linux) and BSD stat (macOS) use different flags, so try both. A
# present .env whose mode cannot be inspected also fails closed; a missing file
# remains Compose's responsibility, preserving the existing deployment flow.
if [ -e .env ]; then
  if env_mode="$(stat -L -c '%a' .env 2>/dev/null)"; then
    :
  elif env_mode="$(stat -L -f '%Lp' .env 2>/dev/null)"; then
    :
  else
    echo "deploy: refusing to run — cannot verify ${OMXTERM_DIR}/.env permissions." >&2
    exit 1
  fi

  case "${env_mode}" in
    ''|*[!0-7]*)
      echo "deploy: refusing to run — invalid mode '${env_mode}' reported for ${OMXTERM_DIR}/.env." >&2
      exit 1
      ;;
  esac

  if (( (8#${env_mode} & 8#77) != 0 )); then
    echo "deploy: refusing to run — ${OMXTERM_DIR}/.env mode is ${env_mode}; remove all group or world permissions (recommended mode 600)." >&2
    exit 1
  fi
fi

# Refuse to run against a dirty checkout. Tracked or untracked changes stop the
# deploy here, before Docker, preserving every file byte-for-byte.
if [ -n "$(git status --porcelain)" ]; then
  echo "deploy: refusing to run — ${OMXTERM_DIR} has uncommitted or untracked changes." >&2
  echo "deploy: commit, stash, or remove them and re-run. Nothing was changed." >&2
  exit 1
fi

# Confirm we are on the deploy branch with a configured upstream before syncing.
current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "${current_branch}" != "${DEPLOY_BRANCH}" ]; then
  echo "deploy: refusing to run — on branch '${current_branch}', expected '${DEPLOY_BRANCH}'." >&2
  exit 1
fi

upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
if [ -z "${upstream}" ]; then
  echo "deploy: refusing to run — '${DEPLOY_BRANCH}' has no upstream to fast-forward from." >&2
  exit 1
fi

expected_upstream="origin/${DEPLOY_BRANCH}"
if [ "${upstream}" != "${expected_upstream}" ]; then
  echo "deploy: refusing to run — '${DEPLOY_BRANCH}' tracks '${upstream}', expected '${expected_upstream}'." >&2
  exit 1
fi

git fetch --prune origin

local_sha="$(git rev-parse HEAD)"
remote_sha="$(git rev-parse '@{upstream}')"
base_sha="$(git merge-base HEAD '@{upstream}')"

# Fast-forward only. If HEAD is not an ancestor of the upstream, the branch has
# diverged (or is ahead) and cannot be fast-forwarded — fail instead of merging
# or rewriting history.
if [ "${local_sha}" != "${remote_sha}" ]; then
  if [ "${base_sha}" != "${local_sha}" ]; then
    echo "deploy: refusing to run — '${DEPLOY_BRANCH}' has diverged from ${upstream}; not merging or rewriting." >&2
    exit 1
  fi
  git merge --ff-only '@{upstream}'
fi

# Rebuild and recreate only the OMXTerm Web service. The reverse proxy is left
# untouched so unrelated routes stay up. -f paths resolve against the checkout
# we cd'd into above.
compose_files=(-f "${OMXTERM_COMPOSE_FILE}")
if [ -n "${OMXTERM_COMPOSE_OVERRIDE}" ]; then
  compose_files+=(-f "${OMXTERM_COMPOSE_OVERRIDE}")
fi

compose_command=(
  docker compose
  --project-name omxterm-web
  --project-directory "${OMXTERM_DIR}"
  "${compose_files[@]}"
)

if ! "${compose_command[@]}" up -d --build --force-recreate --remove-orphans \
  --wait --wait-timeout "${OMXTERM_DEPLOY_WAIT_TIMEOUT}" \
  "${OMXTERM_SERVICE}"; then
  echo "deploy: broker did not become healthy; bounded diagnostics follow." >&2
  "${compose_command[@]}" ps "${OMXTERM_SERVICE}" >&2 || true
  "${compose_command[@]}" logs --no-color --tail 80 "${OMXTERM_SERVICE}" >&2 || true
  exit 1
fi
