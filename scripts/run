#!/usr/bin/env bash

set -euo pipefail

SCRIPTS_DIR="$(realpath "$(dirname "${BASH_SOURCE[0]}")")"
ROOT_DIR="$(dirname "${SCRIPTS_DIR}")"
dotenv_env=()

if [ -f "${ROOT_DIR}/.env" ]; then
  dotenv_output="$(mktemp "${TMPDIR:-/tmp}/omxterm-run-dotenv.XXXXXX")"

  cleanup_dotenv_output() {
    rm -f -- "${dotenv_output}"
  }
  trap cleanup_dotenv_output EXIT

  node "${SCRIPTS_DIR}/parse-dotenv.mjs" "${ROOT_DIR}/.env" >"${dotenv_output}"
  while IFS= read -r -d '' entry; do
    dotenv_env+=("${entry}")
  done <"${dotenv_output}"

  cleanup_dotenv_output
  trap - EXIT
fi

pids=()

cleanup() {
  local status=$?
  trap - EXIT INT TERM

  for pid in "${pids[@]}"; do
    if kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
    fi
  done

  wait "${pids[@]}" 2>/dev/null || true
  exit "${status}"
}

trap cleanup EXIT INT TERM

env -- "${dotenv_env[@]}" npm run dev:server "${@}" &
pids+=("$!")

env -- "${dotenv_env[@]}" npm run dev:web "${@}" &
pids+=("$!")

while true; do
  running_pids="$(jobs -pr)"

  for pid in "${pids[@]}"; do
    if ! grep -qx "${pid}" <<<"${running_pids}"; then
      set +e
      wait "${pid}"
      status=$?
      set -e
      exit "${status}"
    fi
  done

  sleep 1
done
